from pathlib import Path
import shutil
import tempfile

def process_month(folder, verbose=False):
    present = {}
    absent = {}
    damaged = []

    for path in sorted(Path(folder).glob("*.txt")):
        try:
            with open(path, "r", encoding="utf-8") as f:
                for line_no, line in enumerate(f, start=1):
                    parts = line.strip().split(",")

                    if len(parts) != 3:
                        damaged.append(
                            (path.name, line_no,
                             f"expected 3 fields, found {len(parts)}")
                        )
                        continue

                    reg, date, status = parts

                    if status not in ("P", "A"):
                        damaged.append(
                            (path.name, line_no,
                             f"invalid status {status!r}")
                        )
                        continue

                    table = present if status == "P" else absent
                    table[reg] = table.get(reg, 0) + 1

                    if verbose:
                        print(
                            f"line {line_no}: {line.strip()} "
                            f"-> present={present} absent={absent}"
                        )

        except (OSError, UnicodeDecodeError) as error:
            damaged.append((path.name, 0, str(error)))

    return present, absent, damaged


def write_reports(present, absent, damaged, out_dir="."):
    out = Path(out_dir)
    out.mkdir(parents=True, exist_ok=True)

    students = sorted(set(present) | set(absent))

    with open(out / "attendance_report.csv", "w",
              encoding="utf-8") as f:
        f.write("register_no,present,total,percentage\n")

        for reg in students:
            p = present.get(reg, 0)
            a = absent.get(reg, 0)
            total = p + a
            pct = 100 * p / total if total else 0

            f.write(f"{reg},{p},{total},{pct:.2f}\n")

    with open(out / "below_75.txt", "w",
              encoding="utf-8") as f:
        for reg in students:
            p = present.get(reg, 0)
            a = absent.get(reg, 0)
            total = p + a
            pct = 100 * p / total if total else 0

            if pct < 75:
                f.write(f"{reg} {pct:.2f}%\n")

    with open(out / "damaged_lines.log", "w",
              encoding="utf-8") as f:
        for name, line_no, reason in damaged:
            f.write(f"{name} line {line_no}: {reason}\n")


# Trace one small file
print("TRACE for 2026-10-02.txt")

with tempfile.TemporaryDirectory() as temp:
    source = Path("attendance_oct/2026-10-02.txt")

    if source.exists():
        shutil.copy(source, temp)
        process_month(temp, verbose=True)

# Process the complete month
present, absent, damaged = process_month("attendance_oct")
write_reports(present, absent, damaged)

for name in (
    "attendance_report.csv",
    "below_75.txt",
    "damaged_lines.log"
):
    print(f"\n--- {name} ---")
    path = Path(name)

    if path.exists():
        print(path.read_text(encoding="utf-8"), end="")
